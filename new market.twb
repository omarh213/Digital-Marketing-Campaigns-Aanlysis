                <zone forceUpdate='true' h='63294' id='18' type-v2='text' w='12857' x='87143' y='32588'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Key Insights</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>.</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Facebook, Instagram, and TikTok Ads generated </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>comparable levels of revenue and profit</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>, indicating balanced performance across channels. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>.</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>ROI differs between channels, highlighting that higher spending does not always result in better returns. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>.</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Impressions and clicks remain relatively consistent across platforms, suggesting similar audience reach. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>.</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Marketing budget should prioritize channels with the highest ROI rather than those with the highest impressions alone. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Æ  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Æ  </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
